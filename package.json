{
  "name": "owncanvas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "commit:title": "node scripts/check-commit-title.mjs",
    "commit:title:test": "node --test scripts/check-commit-title.test.mjs",
    "dev": "react-router dev",
    "owncanvas:cli": "node --experimental-strip-types app/features/owncanvas-cli/cli.ts",
    "start": "react-router-serve ./build/server/index.js",
    "skills:check": "node scripts/check-skills.mjs",
    "skills:check:strict": "node scripts/check-skills.mjs --strict",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
